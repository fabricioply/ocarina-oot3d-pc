+// OcarinaMod (PC): which microphone the ocarina hears. Every change applies at
+// once and is saved next to the other settings; the meter rows are refreshed
+// every frame by SyncMicrophone while the tab is shown.
+void InGameMenu::BuildMicrophoneTab(Menu::Document &document) {
+  Menu::Tab tab;
+  tab.Title = "Microfone da Ocarina";
+  const auto info = [](std::string key, std::string help) {
+    Row row;
+    row.Key = std::move(key);
+    row.Kind = RowKind::Info;
+    row.Help = std::move(help);
+    return row;
+  };
+  tab.Rows.push_back(Heading("Microfone da Ocarina"));
+  {
+    Row row;
+    row.Key = "Ativar microfone";
+    row.Kind = RowKind::Toggle;
+    row.Help = "Toque, cantarole ou assobie com a ocarina sacada e o jogo toca a m\xC3\xBAsica. Desligado, a ocarina "
+               "usa apenas os bot\xC3\xB5""es. O iniciador INICIAR_COM_MICROFONE liga o microfone a cada partida.";
+    row.Read = [this] { return mOwners.Microphone->Enabled() ? 1 : 0; };
+    row.Write = [this](int value) { return mOwners.Microphone->SetEnabled(value != 0); };
+    tab.Rows.push_back(std::move(row));
+  }
+  {
+    Row row;
+    row.Key = "Dispositivo";
+    row.Kind = RowKind::Choice;
+    row.Help = "O microfone usado. A troca vale na hora e fica salva. Se ele for desconectado, o padr\xC3\xA3o do "
+               "Windows assume; reconecte e use Atualizar lista para voltar a ele.";
+    row.Choices = mOwners.Microphone->DeviceChoices();
+    row.Read = [this] { return mOwners.Microphone->SelectedDevice(); };
+    row.Write = [this](int value) { return mOwners.Microphone->SelectDevice(value); };
+    mMicDeviceRow = tab.Rows.size();
+    tab.Rows.push_back(std::move(row));
+  }
+  {
+    Row row;
+    row.Key = "Atualizar lista";
+    row.Kind = RowKind::Action;
+    row.Help = "Procura de novo os microfones do Windows, depois de ligar ou desligar um.";
+    row.Activate = [this] { return mOwners.Microphone->RefreshDevices(); };
+    tab.Rows.push_back(std::move(row));
+  }
+  tab.Rows.push_back(Heading("Sinal"));
+  mMicActiveRow = tab.Rows.size();
+  tab.Rows.push_back(info("Em uso", "O dispositivo aberto agora."));
+  mMicLevelRow = tab.Rows.size();
+  tab.Rows.push_back(info("N\xC3\xADvel", "O volume que chega do microfone."));
+  mMicNoteRow = tab.Rows.size();
+  tab.Rows.push_back(info("\xC3\x9Altima nota", "A \xC3\xBAltima altura reconhecida."));
+  mMicProblemRow = tab.Rows.size();
+  tab.Rows.push_back(info("Estado", "Erros ao abrir o microfone aparecem aqui."));
+  mMicFileRow = tab.Rows.size();
+  tab.Rows.push_back(info("Arquivo", "Onde a escolha fica salva."));
+  mMicrophoneTab = document.Tabs.size();
+  mMicRevision = mOwners.Microphone->DevicesRevision();
+  document.Tabs.push_back(std::move(tab));
+}
+
+void InGameMenu::SyncMicrophone() {
+  if (!mOwners.Microphone || mMicrophoneTab == kNoRow) return;
+  const bool visible = mModel.IsOpen() && mModel.TabIndex() == mMicrophoneTab;
+  auto &microphone = *mOwners.Microphone;
+  // Entering the tab lists the devices again (one may have been plugged in).
+  if (visible && !mMicrophoneVisible) (void)microphone.RefreshDevices();
+  mMicrophoneVisible = visible;
+  microphone.SetMonitoring(visible);
+  if (!visible || mMicrophoneTab >= mModel.Doc().Tabs.size()) return;
+  auto &rows = mModel.Doc().Tabs[mMicrophoneTab].Rows;
+  if (microphone.DevicesRevision() != mMicRevision && mModel.FocusPane() != Menu::Pane::Choices &&
+      mMicDeviceRow < rows.size()) {
+    rows[mMicDeviceRow].Choices = microphone.DeviceChoices();
+    mMicRevision = microphone.DevicesRevision();
+    mModel.Refresh();
+  }
+  const auto status = microphone.Status();
+  const auto set = [&rows](std::size_t index, std::string text) {
+    if (index < rows.size()) rows[index].Text = std::move(text);
+  };
+  std::string active = status.DeviceLabel;
+  if (!status.Enabled && !status.Open) active += " (desligado)";
+  else if (!status.Open) active += " (fechado)";
+  else if (status.Listening) active += " (ouvindo)";
+  set(mMicActiveRow, std::move(active));
+  set(mMicLevelRow, status.Open ? status.LevelText : std::string("\xE2\x80\x94"));
+  std::string note = "\xE2\x80\x94";
+  if (!status.LastNote.empty()) {
+    note = status.LastNote;
+    if (status.LastNoteAgeSeconds >= 0.0 && status.LastNoteAgeSeconds < 0.5) note += " (agora)";
+    else if (status.LastNoteAgeSeconds >= 0.0)
+      note += " (h\xC3\xA1 " + std::to_string(static_cast<int>(status.LastNoteAgeSeconds)) + " s)";
+  }
+  set(mMicNoteRow, std::move(note));
+  set(mMicProblemRow, status.Problem.empty() ? std::string("OK") : status.Problem);
+  set(mMicFileRow, status.ConfigPath);
+}
