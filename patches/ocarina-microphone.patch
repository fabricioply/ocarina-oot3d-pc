+#define NOMINMAX
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include "real_instrument/game_microphone.h"
+#include "test_support.h"
+#include <chrono>
+int main(){
+    char original[32768]{};DWORD length=GetEnvironmentVariableA("TRIAEVUM_OCARINA_MIC_DEVICE",original,sizeof(original));
+    CHECK(length<sizeof(original));
+    // The implementation reads the CRT environment. SetEnvironmentVariable
+    // alone changes only Win32's copy after CRT startup.
+    struct Restore {const char* text;bool exists;~Restore(){_putenv_s("TRIAEVUM_OCARINA_MIC_DEVICE",exists?text:"");}} restore{original,length>0};
+    _putenv_s("TRIAEVUM_OCARINA_MIC_DEVICE","invalid-test-device");
+    real_instrument::GameMicrophone mic;
+    CHECK(!mic.Tick({},false,0).listen);
+    real_instrument::OcarinaGameState state;state.canPlay=true;state.context=123;
+    CHECK(mic.Tick(state,false,0.1).listen);
+    bool recovered=false;
+    for(int i=0;i<200;++i){
+        Sleep(10);auto output=mic.Tick(state,false,0.11+i*0.01);
+        if(!output.listen && output.audioGain==1){recovered=true;break;}
+    }
+    CHECK(recovered);mic.Reset();CHECK(!mic.Tick({},false,3).listen);
+}
diff --git a/tools/real_instrument/tests/test_matcher.cpp b/tools/real_instrument/tests/test_matcher.cpp
new file mode 100644
index 00000000..36ff503f
--- /dev/null
+++ b/tools/real_instrument/tests/test_matcher.cpp
@@ -0,0 +1,133 @@
+#include "real_instrument/song_catalog.h"
+#include "test_support.h"
+#include <algorithm>
+using namespace real_instrument;
+std::optional<SongResult> play(SongMatcher& m,std::vector<float> pitches,double duration=0.3,double start=0) {
+    std::optional<SongResult> result;
+    double t=start;
+    for(float p:pitches) { auto r=m.Push({t,t+duration,p,0.99f}); if(r) result=r; t+=duration+0.08; }
+    return result;
+}
+int main() {
+    // All twelve standard songs, including the 5/7/8-note warp melodies.
+    const std::vector<std::pair<const char*,std::vector<float>>> melodies={
+        {"Saria's Song",{65,69,71,65,69,71}},
+        {"Epona's Song",{74,71,69,74,71,69}},
+        {"Sun's Song",{69,65,74,69,65,74}},
+        {"Song of Storms",{62,65,74,62,65,74}},
+        {"Minuet of Forest",{62,74,71,69,71,69}},
+        {"Bolero of Fire",{65,62,65,62,69,65,69,65}},
+        {"Serenade of Water",{62,65,69,69,71}},
+        {"Requiem of Spirit",{62,65,62,69,65,62}},
+        {"Nocturne of Shadow",{71,69,69,62,71,69,65}},
+        {"Prelude of Light",{74,69,74,69,71,74}}};
+    CHECK(SongCatalog().size()==12);
+    for(const auto& entry:melodies) {
+        SongMatcher all(SongCatalog());auto recognized=play(all,entry.second);
+        CHECK(recognized);CHECK(recognized->id==entry.first);
+    }
+
+    // Scope old negative cases to the original two-song catalog. Some of
+    // those phrases intentionally approximate newly supported melodies.
+    auto original=SongCatalog();
+    original.erase(std::remove_if(original.begin(),original.end(),[](const SongDefinition& song){
+        return song.id!="Song of Time" && song.id!="Zelda's Lullaby";
+    }),original.end());
+    for(float start:{48.f,60.f,72.f}) for(double duration:{0.15,0.6}) {
+        SongMatcher m(SongCatalog());
+        auto r=play(m,{start,start-7,start-4,start,start-7,start-4},duration);
+        CHECK(r); CHECK(r->id=="Song of Time"); CHECK(r->confidence>=0.8f);
+    }
+    SongMatcher m(original);
+    CHECK(play(m,{60.4f,52.6f,56.4f,59.6f,53.4f,55.6f}));
+    m.Reset(); CHECK(!play(m,{60,53,56,60,53}));
+    m.Reset(); CHECK(!play(m,{60,53,59,60,53,56}));
+    m.Reset(); CHECK(!play(m,{56,53,60,56,53,60}));
+    m.Reset(); CHECK(!play(m,{60,54,58,63,57,61}));
+    SongMatcher precise(SongCatalog(),false);
+    CHECK(!play(precise,{60.4f,52.6f,56.4f,59.6f,53.4f,55.6f}));
+    auto duplicate=SongCatalog(); duplicate.push_back({"ambiguous",{0,-7,-4,0,-7,-4}});
+    SongMatcher ambiguous(duplicate); CHECK(!play(ambiguous,{60,53,56,60,53,56}));
+    m.Reset(); CHECK(!play(m,{60,53,56,60,53,56},5));
+    m.Reset(); CHECK(play(m,{60,53,56,60,53,56}));
+    CHECK(!play(m,{60,53,56,60,53,56}));
+    m.Reset(); CHECK(play(m,{60,53,56,60,53,56}));
+    SongMatcher lullaby(SongCatalog());
+    auto z=play(lullaby,{71,74,69,71,74,69});
+    CHECK(z);CHECK(z->id=="Zelda's Lullaby");
+    lullaby.Reset();z=play(lullaby,{59,62,57,59,62,57});
+    CHECK(z);CHECK(z->id=="Zelda's Lullaby");
+    lullaby.Reset();CHECK(!play(lullaby,{71,74,69,71,74,73}));
+    // Slide / grace note between stable melody notes. Full melody is still
+    // required; a short intermediate pitch must not break the alignment.
+    SongMatcher ornamented(SongCatalog());double t=0;std::optional<SongResult> found;
+    const float embellished[]={60,53,54,53,56,60,53,56};
+    const double lengths[]={0.4,0.3,0.10,0.3,0.4,0.4,0.3,0.4};
+    for(size_t i=0;i<8;++i){auto r=ornamented.Push({t,t+lengths[i],embellished[i],0.99f});if(r)found=r;t+=lengths[i];}
+    CHECK(found);CHECK(found->id=="Song of Time");
+    // Bends around the target can be broader than precise tuning, with the
+    // whole melody still matching a common transposition.
+    SongMatcher assistedBends(SongCatalog());
+    CHECK(play(assistedBends,{60.8f,52.2f,56.8f,59.2f,53.8f,55.2f}));
+    // Stable wrong notes cannot be deleted to fabricate a song.
+    SongMatcher wrongStable(SongCatalog());
+    CHECK(!play(wrongStable,{60,53,59,56,60,53,56}));
+    SongMatcher preciseOrnaments(SongCatalog(),false);t=0;found.reset();
+    for(size_t i=0;i<8;++i){auto r=preciseOrnaments.Push({t,t+lengths[i],embellished[i],0.99f});if(r)found=r;t+=lengths[i];}
+    CHECK(!found);
+    SongMatcher hinting(original);
+    hinting.Push({0,0.4,71,0.99f});
+    CHECK(!hinting.Hint());
+    hinting.Push({0.4,0.8,74,0.99f});
+    auto hint=hinting.Hint();CHECK(hint);CHECK(hint->id=="Zelda's Lullaby");
+    CHECK(hint->matchedNotes==2);CHECK(hint->totalNotes==6);
+    hinting.Reset();CHECK(!hinting.Hint());
+    // A compressed Storms-like rise must not be silently turned into Saria.
+    // Both repeated triplets need the characteristic small/big final leap.
+    SongMatcher uncertain(SongCatalog());
+    CHECK(!play(uncertain,{60,63,67,60,63,67}));
+    auto uncertainHint=uncertain.Hint();CHECK(uncertainHint);
+    CHECK(uncertainHint->id=="Saria's Song");
+    CHECK(uncertainHint->alternative=="Song of Storms");
+    // A complete clear retry resolves without closing/restarting the session.
+    auto resolved=play(uncertain,{60,63,72,60,63,72},0.3,3);
+    CHECK(resolved);CHECK(resolved->id=="Song of Storms");
+    for(float base:{48.f,62.f,74.f}){
+        SongMatcher saria(SongCatalog()),storms(SongCatalog());
+        auto small=play(saria,{base+.2f,base+3.8f,base+6.1f,base-.2f,base+4.2f,base+5.9f});
+        CHECK(small);CHECK(small->id=="Saria's Song");
+        auto large=play(storms,{base+.2f,base+2.8f,base+12.1f,base-.2f,base+3.2f,base+11.9f});
+        CHECK(large);CHECK(large->id=="Song of Storms");
+    }
+    // Mixed evidence between the two halves must not choose Saria either.
+    SongMatcher mixed(SongCatalog());
+    CHECK(!play(mixed,{60,63,67,60,64,66}));
+    // Actual local log: ascending motifs between Saria and Storms should
+    // offer the pair, not disappear or activate a different song.
+    SongMatcher logged(SongCatalog());
+    CHECK(!play(logged,{55.0247f,59.2852f,64.4151f,53.7477f,59.7846f,64.6631f}));
+    CHECK(logged.Hint());CHECK(logged.Hint()->alternative=="Song of Storms");
+    // Fragments separated by a new attempt must not complete an old melody.
+    SongMatcher attempts(SongCatalog());
+    CHECK(!play(attempts,{71,74,69}));
+    CHECK(!play(attempts,{71,74,69},0.3,3));
+    // A tiny transition fragment is ignored, rather than wiping the phrase.
+    SongMatcher tiny(SongCatalog());
+    tiny.Push({0,.3,65,.99f});tiny.Push({.3,.6,69,.99f});
+    tiny.Push({.6,.64,70,.99f});tiny.Push({.64,.94,71,.99f});
+    tiny.Push({.94,1.24,65,.99f});tiny.Push({1.24,1.54,69,.99f});
+    auto tinyResult=tiny.Push({1.54,1.84,71,.99f});CHECK(tinyResult);CHECK(tinyResult->id=="Saria's Song");
+    // Assisted mode: a sloppy but same-shaped phrase must be PROPOSED, never lost.
+    // Zelda's Lullaby (+3,+5,-9,+3,+5 ideal) played with off intervals.
+    SongMatcher sloppy(SongCatalog());
+    CHECK(!play(sloppy,{71,76,68,73,77,69}));
+    auto sloppyHint=sloppy.Finish();CHECK(sloppyHint);CHECK(!sloppyHint->candidates.empty());
+    // Wrong direction is not "similar": no proposal.
+    SongMatcher wrongWay(SongCatalog());
+    CHECK(!play(wrongWay,{60,62,64,66,68,70}));
+    CHECK(!wrongWay.Finish());
+    // Precise (non-assisted) mode never proposes.
+    SongMatcher strict(SongCatalog(),false);
+    play(strict,{71,76,68,73,77,69});
+    CHECK(!strict.Finish());
+}
diff --git a/tools/real_instrument/tests/test_mic_controller.cpp b/tools/real_instrument/tests/test_mic_controller.cpp
new file mode 100644
index 00000000..4d273453
--- /dev/null
+++ b/tools/real_instrument/tests/test_mic_controller.cpp
@@ -0,0 +1,69 @@
+// v0.6.0: the host's microphone owner with real Windows enumeration, a
+// temporary config file and no environment. It never listens; a device is
+// opened only by the monitoring check at the end (no audio is kept).
+#define NOMINMAX
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include "real_instrument/mic_controller.h"
+#include "test_support.h"
+#include <chrono>
+#include <filesystem>
+using namespace real_instrument;
+int main() {
+    const auto dir = std::filesystem::temp_directory_path() /
+                     ("ocarina_mic_ctl_" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    const auto path = dir / kMicSettingsFileName;
+    {
+        MicController::Options options;
+        options.configPath = path;
+        options.environmentDevice = "999";  // not in any list
+        MicController controller(options);
+        CHECK(!controller.Enabled() && controller.GameInput() == nullptr);
+        CHECK(controller.Notice().find("TRIAEVUM_OCARINA_MIC_DEVICE") != std::string::npos);
+        CHECK(!controller.ChoiceLabels().empty() && controller.SelectedChoice() == 0);
+        CHECK(!std::filesystem::exists(path));  // startup never writes
+        CHECK(!controller.SelectChoice(-1).message.empty() && controller.SelectChoice(-1).error);
+        auto result = controller.SelectChoice(0);
+        CHECK(!result.error && std::filesystem::exists(path));
+        result = controller.SetEnabled(true);
+        CHECK(!result.error && controller.Enabled() && controller.GameInput() != nullptr);
+        const auto revision = controller.DevicesRevision();
+        controller.RefreshDevices();
+        CHECK(controller.DevicesRevision() != revision);
+        CHECK(!controller.ActiveDeviceLabel().empty());
+    }
+    {
+        // The saved choice is read back: on, the default device.
+        MicController::Options options;
+        options.configPath = path;
+        MicController controller(options);
+        CHECK(controller.Enabled() && controller.SelectedChoice() == 0);
+        CHECK(!controller.SetEnabled(false).error && controller.GameInput() == nullptr);
+        // TRIAEVUM_OCARINA_MIC=1 (the launcher) wins over the saved box.
+        options.environmentEnabled = "1";
+        MicController forced(options);
+        CHECK(forced.Enabled());
+    }
+    {
+        // A device that cannot be opened: an error line, and either the
+        // default device (fallback) or, on a PC without one, a failure. No crash.
+        GameMicrophone mic;
+        mic.SetDevice("not-a-real-windows-endpoint");
+        mic.SetMonitoring(true);
+        bool reported = false, fellBack = false;
+        for (int i = 0; i < 300 && !reported; ++i) {
+            Sleep(10);
+            const auto status = mic.Status();
+            reported = !status.error.empty();
+            if (reported && status.open) {
+                CHECK(status.fellBack && status.activeDeviceId.empty());
+                fellBack = true;
+            }
+        }
+        CHECK(reported);
+        mic.SetDevice("");  // back to the default; the error line clears
+        if (fellBack) CHECK(mic.Status().error.empty());
+        mic.SetMonitoring(false);
+    }
+    std::filesystem::remove_all(dir);
+}
diff --git a/tools/real_instrument/tests/test_mic_settings.cpp b/tools/real_instrument/tests/test_mic_settings.cpp
new file mode 100644
index 00000000..d08d991d
--- /dev/null
+++ b/tools/real_instrument/tests/test_mic_settings.cpp
@@ -0,0 +1,128 @@
+// v0.6.0: the saved microphone choice, the startup priority and the menu's
+// device list model (pure logic, no audio device).
+#include "real_instrument/mic_settings.h"
+#include "test_support.h"
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <string>
+using namespace real_instrument;
+namespace {
+const std::vector<MicDeviceEntry> kDevices{
+    {"{0.0.1.00000000}.{aaaa}", "Microfone (USB Audio)"},
+    {"{0.0.1.00000000}.{bbbb}", "Headset"},
+    {"{0.0.1.00000000}.{cccc}", "Headset"},
+};
+void RoundTrip() {
+    MicSettings settings;
+    settings.enabled = true;
+    settings.deviceId = "{0.0.1.00000000}.{aaaa}";
+    settings.deviceName = "Microfone \"Sal\xC3\xA3o\" \\ 1\n";
+    const auto text = SerializeMicSettings(settings);
+    CHECK(text.find("ocarina_microfone_v1") != std::string::npos);
+    MicSettings parsed;
+    std::string error;
+    CHECK(ParseMicSettings(text, &parsed, &error));
+    CHECK(parsed == settings);
+    // BOM, unknown keys, numbers, null and \u escapes (with a surrogate pair).
+    CHECK(ParseMicSettings("\xEF\xBB\xBF{\"enabled\": false, \"x\": 12.5, \"y\": null, \"device_name\": \"\\u00e9\\ud83c\\udfb5\"}", &parsed, &error));
+    CHECK(!parsed.enabled && parsed.deviceId.empty() && parsed.deviceName == "\xC3\xA9\xF0\x9F\x8E\xB5");
+    CHECK(ParseMicSettings("{}", &parsed, &error) && parsed == MicSettings{});
+    // Malformed and wrong types are rejected with a message.
+    for (const char* bad : {"", "[]", "{\"enabled\": 1}", "{\"enabled\": true,}", "{\"device_id\": true}",
+                            "{\"format\": \"other\"}", "{\"device_id\": \"x\"} trailing", "{\"device_id\": \"\\ud800\"}"}) {
+        error.clear();
+        CHECK(!ParseMicSettings(bad, &parsed, &error));
+        CHECK(!error.empty());
+    }
+}
+void Files() {
+    const auto dir = std::filesystem::temp_directory_path() /
+                     ("ocarina_mic_test_" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+    const auto path = dir / "config" / kMicSettingsFileName;
+    MicSettings settings, loaded;
+    std::string error;
+    CHECK(LoadMicSettingsFile(path, &loaded, &error) == MicFileLoad::Missing);
+    settings.enabled = true;
+    settings.deviceId = "id-1";
+    settings.deviceName = "Nome";
+    CHECK(SaveMicSettingsFile(path, settings, &error));  // creates config/
+    CHECK(LoadMicSettingsFile(path, &loaded, &error) == MicFileLoad::Loaded && loaded == settings);
+    settings.enabled = false;
+    CHECK(SaveMicSettingsFile(path, settings, &error));  // replaces the file
+    CHECK(LoadMicSettingsFile(path, &loaded, &error) == MicFileLoad::Loaded && loaded == settings);
+    CHECK(!std::filesystem::exists(path.string() + ".tmp"));
+    { std::ofstream(path, std::ios::trunc) << "{ not json"; }
+    CHECK(LoadMicSettingsFile(path, &loaded, &error) == MicFileLoad::Invalid && !error.empty());
+    std::filesystem::remove_all(dir);
+}
+void Resolution() {
+    // By ID first, then by name (the ID changed), else the default.
+    auto r = ResolveMicDevice(kDevices, {true, "{0.0.1.00000000}.{cccc}", "Headset"});
+    CHECK(r.found && r.id == "{0.0.1.00000000}.{cccc}" && !r.matchedByName);
+    r = ResolveMicDevice(kDevices, {true, "gone", "Microfone (USB Audio)"});
+    CHECK(r.found && r.matchedByName && r.id == "{0.0.1.00000000}.{aaaa}");
+    r = ResolveMicDevice(kDevices, {true, "gone", "Unplugged"});
+    CHECK(!r.found && r.id.empty() && r.name == kMicDefaultDeviceLabel);
+    r = ResolveMicDevice(kDevices, {});
+    CHECK(r.found && r.requestedDefault && r.id.empty());
+    r = ResolveMicDevice({}, {true, "gone", "Unplugged"});
+    CHECK(!r.found && r.id.empty());
+    CHECK(ParseMicDeviceIndex("2", 3) == std::optional<std::size_t>(2));
+    CHECK(!ParseMicDeviceIndex("3", 3) && !ParseMicDeviceIndex("-1", 3) && !ParseMicDeviceIndex("1x", 3) &&
+          !ParseMicDeviceIndex("", 3) && !ParseMicDeviceIndex("99999999999", 3));
+}
+void Startup() {
+    const MicSettings saved{false, "{0.0.1.00000000}.{bbbb}", "Headset"};
+    // Environment index > saved > default.
+    auto plan = PlanMicStartup("1", "0", saved, kDevices);
+    CHECK(plan.enabled && plan.source == MicSelectionSource::Environment && plan.device.id == kDevices[0].id && plan.notice.empty());
+    plan = PlanMicStartup("1", "", saved, kDevices);
+    CHECK(plan.enabled && plan.source == MicSelectionSource::Saved && plan.device.id == kDevices[1].id);
+    plan = PlanMicStartup("", "", std::nullopt, kDevices);
+    CHECK(!plan.enabled && plan.source == MicSelectionSource::Default && plan.device.id.empty());
+    // An index outside the list falls to the saved choice, with a notice.
+    plan = PlanMicStartup("1", "7", saved, kDevices);
+    CHECK(plan.source == MicSelectionSource::Saved && plan.device.id == kDevices[1].id && !plan.notice.empty());
+    plan = PlanMicStartup("1", "abc", std::nullopt, kDevices);
+    CHECK(plan.source == MicSelectionSource::Default && plan.device.id.empty() && !plan.notice.empty());
+    // Enabled: the launcher's =1 wins, =0 turns it off, otherwise the saved box.
+    CHECK(!PlanMicStartup("", "", saved, kDevices).enabled);
+    CHECK(PlanMicStartup("", "", MicSettings{true, "", ""}, kDevices).enabled);
+    CHECK(!PlanMicStartup("0", "", MicSettings{true, "", ""}, kDevices).enabled);
+    // A saved device that is unplugged: the default, and a notice naming it.
+    plan = PlanMicStartup("1", "", MicSettings{true, "gone", "USB Mic"}, kDevices);
+    CHECK(plan.device.id.empty() && !plan.device.found && plan.notice.find("USB Mic") != std::string::npos);
+    CHECK(plan.wanted.deviceName == "USB Mic");  // kept, so it returns when replugged
+}
+void Choices() {
+    const auto labels = MicChoiceLabels(kDevices);
+    CHECK(labels.size() == 4 && labels[0] == kMicDefaultDeviceLabel && labels[1] == "Microfone (USB Audio)");
+    CHECK(labels[2] == "Headset (1)" && labels[3] == "Headset (2)");
+    CHECK(MicChoiceLabels({}).size() == 1);
+    CHECK(MicChoiceIndex(kDevices, "") == 0 && MicChoiceIndex(kDevices, kDevices[2].id) == 3 && MicChoiceIndex(kDevices, "gone") == 0);
+    auto chosen = MicSettingsForChoice(kDevices, 2, true);
+    CHECK(chosen.enabled && chosen.deviceId == kDevices[1].id && chosen.deviceName == "Headset");
+    CHECK(MicSettingsForChoice(kDevices, 0, false) == MicSettings{});
+    CHECK(MicSettingsForChoice(kDevices, 9, false) == MicSettings{});
+}
+void Display() {
+    CHECK(MicLevelBar(0.0f, 10).find('|') == std::string::npos);
+    CHECK(MicLevelBar(1.0f, 10) == "||||||||||");
+    const auto half = MicLevelBar(0.001f, 10);  // -60 dB: empty; -30 dB: half
+    CHECK(half.find('|') == std::string::npos);
+    const auto mid = MicLevelBar(0.0316f, 10);
+    CHECK(mid.substr(0, 5) == "|||||" && mid[5] != '|');
+    CHECK(MicLevelDecibels(0.1f) == "-20 dB" && MicLevelDecibels(0) == "sil\xC3\xAAncio");
+    CHECK(MicNoteName(67.2f) == "Sol4" && MicNoteName(74) == "R\xC3\xA9" "5" && MicNoteName(60) == "D\xC3\xB3" "4");
+    CHECK(MicNoteName(-5) == "?");
+}
+}
+int main() {
+    RoundTrip();
+    Files();
+    Resolution();
+    Startup();
+    Choices();
+    Display();
+}
diff --git a/tools/real_instrument/tests/test_notes.cpp b/tools/real_instrument/tests/test_notes.cpp
new file mode 100644
index 00000000..b29446ad
--- /dev/null
+++ b/tools/real_instrument/tests/test_notes.cpp
@@ -0,0 +1,56 @@
+#include "real_instrument/note_tracker.h"
+#include "test_support.h"
+using namespace real_instrument;
+int main() {
+    NoteTracker tracker; std::vector<NoteEvent> notes;
+    double t=0;
+    auto feed=[&](float pitch,int frames,float rms=0.15f,bool vibrato=false) {
+        for(int i=0;i<frames;++i,t+=0.01) {
+            auto event=tracker.Push({t,pitch+(vibrato ? 0.3f*static_cast<float>(std::sin(i)) : 0),0.99f,rms,rms>0});
+            if(event) notes.push_back(*event);
+        }
+    };
+    feed(69,100,0.15f,true); CHECK(notes.empty());
+    feed(0,10,0); CHECK(notes.size()==1); CHECK(std::abs(notes[0].midiPitch-69)<0.1f);
+    CHECK(notes[0].endedAt-notes[0].startedAt>0.9);
+    tracker.Reset(); notes.clear();
+    feed(69,20); feed(0,8,0); feed(69,20); feed(0,8,0); CHECK(notes.size()==2);
+    tracker.Reset(); notes.clear();
+    feed(69,20); feed(72,1); feed(69,20); feed(0,8,0); CHECK(notes.size()==1);
+    tracker.Reset(); notes.clear();
+    feed(69,1); feed(0,8,0); CHECK(notes.empty());
+    feed(69,20); tracker.Reset(); feed(0,8,0); CHECK(notes.empty());
+    feed(69,20); feed(69,8,0.01f); feed(69,20); feed(0,8,0); CHECK(notes.size()==2);
+    tracker.Reset(); notes.clear();
+    feed(69,20); feed(62,20); feed(65,20); feed(0,8,0); CHECK(notes.size()==3);
+    tracker.Reset(); notes.clear();
+    feed(69,20); t+=1; feed(0,8,0); CHECK(notes.empty());
+    tracker.Reset(); notes.clear();
+    // A vocal attack can begin slightly sharp and then settle. The completed
+    // note must represent the stable body, rather than freezing the attack.
+    feed(69.6f,10); feed(69,60); feed(0,8,0);
+    CHECK(notes.size()==1); CHECK(std::abs(notes[0].midiPitch-69)<0.2f);
+    tracker.Reset(); notes.clear();
+    // Sustaining an instrument while its volume decays is still ONE note.
+    // A lifetime peak gate used to manufacture an extra onset below 25%.
+    for(int i=0;i<150;++i)feed(69,1,0.2f*static_cast<float>(std::exp(-i/50.0)));
+    feed(0,10,0);CHECK(notes.size()==1);
+    tracker.Reset();notes.clear();
+    // D -> D# -> D while holding the note is an excursion, not three notes.
+    feed(62,40);feed(63,12);feed(62,40);feed(0,10,0);
+    CHECK(notes.size()==1);CHECK(std::abs(notes[0].midiPitch-62)<0.2f);
+    tracker.Reset();notes.clear();
+    // A slow continuous slide must not become staircase notes. Only its
+    // stable start and landing count.
+    feed(69,30);
+    for(int i=1;i<=70;++i)feed(69-static_cast<float>(i)*0.1f,1);
+    feed(62,30);feed(0,10,0);
+    CHECK(notes.size()==2);CHECK(std::abs(notes[0].midiPitch-69)<0.2f);
+    CHECK(std::abs(notes[1].midiPitch-62)<0.2f);
+    tracker.Reset();notes.clear();
+    // An abrupt pull-off is a true new landing even without silence.
+    feed(69,20);feed(62,12);feed(0,10,0);CHECK(notes.size()==2);
+    tracker.Reset();notes.clear();
+    // An intentional, sustained semitone change still counts.
+    feed(62,30);feed(63,35);feed(0,10,0);CHECK(notes.size()==2);
+}
diff --git a/tools/real_instrument/tests/test_oot3d_state.cpp b/tools/real_instrument/tests/test_oot3d_state.cpp
