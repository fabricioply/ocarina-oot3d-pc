+#include "real_instrument/mic_controller.h"
+#include "wasapi_capture.h"
+#include <cstdlib>
+#include <exception>
+#include <future>
+#include <iostream>
+#include <optional>
+#include <utility>
+namespace real_instrument {
+namespace {
+std::string Environment(const char* name){
+#ifdef _MSC_VER
+    char* value=nullptr;size_t count=0;
+    if(_dupenv_s(&value,&count,name)!=0)return {};
+    std::string result=value?value:"";std::free(value);return result;
+#else
+    const char* value=std::getenv(name);return value?value:"";
+#endif
+}
+std::string PathText(const std::filesystem::path& path){
+    const auto text=path.u8string();return std::string(text.begin(),text.end());
+}
+void Log(const std::string& text){std::cerr<<"Ocarina v0.6.0: "<<text<<'\n';}
+}
+MicController::Options MicController::FromEnvironment(std::filesystem::path configPath){
+    Options options;
+    options.configPath=std::move(configPath);
+    options.environmentEnabled=Environment("TRIAEVUM_OCARINA_MIC");
+    options.environmentDevice=Environment("TRIAEVUM_OCARINA_MIC_DEVICE");
+    return options;
+}
+MicController::MicController(Options options):options_(std::move(options)){
+    MicSettings saved;std::string error;
+    std::optional<MicSettings> loaded;
+    switch(LoadMicSettingsFile(options_.configPath,&saved,&error)){
+    case MicFileLoad::Loaded: loaded=saved;saved_=saved;break;
+    case MicFileLoad::Missing: break;
+    case MicFileLoad::Invalid:
+        notice_="Arquivo de microfone ignorado ("+error+")";break;
+    }
+    ListDevices();
+    auto plan=PlanMicStartup(options_.environmentEnabled,options_.environmentDevice,loaded,devices_);
+    enabled_=plan.enabled;wanted_=plan.wanted;resolvedId_=plan.device.id;
+    if(!plan.notice.empty())notice_=notice_.empty()?plan.notice:notice_+". "+plan.notice;
+    if(!listError_.empty())notice_=notice_.empty()?listError_:notice_+". "+listError_;
+    Log(std::string("microfone ")+(enabled_?"ligado":"desligado")+", dispositivo: "+plan.device.name
+        +" ("+(plan.source==MicSelectionSource::Environment?"TRIAEVUM_OCARINA_MIC_DEVICE"
+              :plan.source==MicSelectionSource::Saved?"escolha salva":"padrao")+"), arquivo: "+PathText(options_.configPath));
+    if(!notice_.empty())Log(notice_);
+    if(enabled_)Microphone();
+}
+MicController::~MicController()=default;
+GameMicrophone& MicController::Microphone(){
+    if(!mic_){
+        mic_=std::make_unique<GameMicrophone>();
+        mic_->SetDevice(resolvedId_);
+        mic_->SetMonitoring(monitoring_);
+    }
+    return *mic_;
+}
+void MicController::ListDevices(){
+    // On a thread of its own: the frame thread may live in a COM apartment
+    // (SDL, the window) that the audio enumeration must not change.
+    try{
+        const auto listed=std::async(std::launch::async,[]{return WasapiCapture::ListDevices();}).get();
+        devices_.clear();
+        for(const auto& device:listed)devices_.push_back({device.id,device.name});
+        listError_.clear();
+    }catch(const std::exception& error){
+        listError_=std::string("N\xC3\xA3o foi poss\xC3\xADvel listar os microfones: ")+error.what();
+    }
+    ++revision_;
+}
+std::string MicController::Save(){
+    std::string error;
+    if(SaveMicSettingsFile(options_.configPath,saved_,&error))return {};
+    Log("nao foi possivel salvar "+PathText(options_.configPath)+": "+error);
+    return error;
+}
+MicController::Result MicController::SetEnabled(bool enabled){
+    if(enabled==enabled_)return {enabled?"Microfone j\xC3\xA1 ligado":"Microfone j\xC3\xA1 desligado",false};
+    enabled_=enabled;saved_.enabled=enabled;
+    // A fresh recognition state either way; off also releases the ocarina.
+    if(enabled)Microphone().Reset();else if(mic_)mic_->Reset();
+    Log(enabled?"microfone ligado pelo menu":"microfone desligado pelo menu");
+    const auto error=Save();
+    if(!error.empty())return {"Aplicado, mas n\xC3\xA3o salvo: "+error,true};
+    return {enabled?"Microfone ligado e salvo":"Microfone desligado e salvo",false};
+}
+std::vector<std::string> MicController::ChoiceLabels() const{return MicChoiceLabels(devices_);}
+int MicController::SelectedChoice() const{return MicChoiceIndex(devices_,resolvedId_);}
+MicController::Result MicController::SelectChoice(int choice){
+    if(choice<0||choice>static_cast<int>(devices_.size()))return {"Escolha de microfone inv\xC3\xA1lida",true};
+    wanted_=MicSettingsForChoice(devices_,choice,enabled_);
+    resolvedId_=wanted_.deviceId;
+    saved_.deviceId=wanted_.deviceId;saved_.deviceName=wanted_.deviceName;saved_.enabled=enabled_;
+    // Applied at once: the capture worker stops the old device and opens this one.
+    if(mic_)mic_->SetDevice(resolvedId_);
+    const std::string name=choice==0?std::string(kMicDefaultDeviceLabel):wanted_.deviceName;
+    Log("dispositivo escolhido no menu: "+name);
+    const auto error=Save();
+    if(!error.empty())return {"Usando "+name+", mas n\xC3\xA3o salvo: "+error,true};
+    return {"Usando "+name+" (salvo)",false};
+}
+MicController::Result MicController::RefreshDevices(){
+    ListDevices();
+    if(!listError_.empty())return {listError_,true};
+    const auto resolution=ResolveMicDevice(devices_,wanted_);
+    const bool fellBack=mic_&&mic_->Status().fellBack;
+    if(resolution.id!=resolvedId_||fellBack){
+        resolvedId_=resolution.id;
+        if(mic_)mic_->SetDevice(resolvedId_);
+    }
+    notice_.clear();
+    std::string message=std::to_string(devices_.size())+(devices_.size()==1?" microfone encontrado":" microfones encontrados");
+    if(!resolution.found){
+        notice_="Microfone \""+(wanted_.deviceName.empty()?wanted_.deviceId:wanted_.deviceName)
+            +"\" n\xC3\xA3o encontrado; usando o padr\xC3\xA3o do Windows";
+        message+=". "+notice_;
+    }
+    return {message,!resolution.found};
+}
+void MicController::SetMonitoring(bool monitoring){
+    if(monitoring==monitoring_)return;
+    monitoring_=monitoring;
+    if(monitoring)Microphone().SetMonitoring(true);
+    else if(mic_)mic_->SetMonitoring(false);
+}
+void MicController::ResetGame(){if(mic_)mic_->Reset();}
+MicrophoneStatus MicController::Status() const{
+    if(!mic_){MicrophoneStatus s;s.requestedDeviceId=resolvedId_;s.activeDeviceId=resolvedId_;return s;}
+    return mic_->Status();
+}
+std::string MicController::NameOf(const std::string& id) const{
+    if(id.empty())return kMicDefaultDeviceLabel;
+    for(const auto& device:devices_)if(device.id==id)return device.name;
+    return id==wanted_.deviceId&&!wanted_.deviceName.empty()?wanted_.deviceName:id;
+}
+std::string MicController::ActiveDeviceLabel() const{
+    const auto status=Status();
+    return NameOf(status.open?status.activeDeviceId:resolvedId_);
+}
+}
diff --git a/tools/real_instrument/src/mic_settings.cpp b/tools/real_instrument/src/mic_settings.cpp
new file mode 100644
index 00000000..591dcb53
--- /dev/null
+++ b/tools/real_instrument/src/mic_settings.cpp
@@ -0,0 +1,359 @@
+#include "real_instrument/mic_settings.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <system_error>
+namespace real_instrument {
+namespace {
+// UTF-8 text of a path in C++17 (std::string) and C++20 (std::u8string).
+std::string PathText(const std::filesystem::path& path) {
+    const auto text = path.u8string();
+    return std::string(text.begin(), text.end());
+}
+void AppendEscaped(std::string& out, const std::string& text) {
+    out += '"';
+    for (unsigned char c : text) {
+        switch (c) {
+        case '"': out += "\\\""; break;
+        case '\\': out += "\\\\"; break;
+        case '\n': out += "\\n"; break;
+        case '\r': out += "\\r"; break;
+        case '\t': out += "\\t"; break;
+        default:
+            if (c < 0x20) {
+                char buffer[8];
+                std::snprintf(buffer, sizeof buffer, "\\u%04x", c);
+                out += buffer;
+            } else {
+                out += static_cast<char>(c);
+            }
+        }
+    }
+    out += '"';
+}
+void AppendUtf8(std::string& out, unsigned long cp) {
+    if (cp < 0x80) out += static_cast<char>(cp);
+    else if (cp < 0x800) { out += static_cast<char>(0xC0 | (cp >> 6)); out += static_cast<char>(0x80 | (cp & 0x3F)); }
+    else if (cp < 0x10000) {
+        out += static_cast<char>(0xE0 | (cp >> 12)); out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F));
+        out += static_cast<char>(0x80 | (cp & 0x3F));
+    } else {
+        out += static_cast<char>(0xF0 | (cp >> 18)); out += static_cast<char>(0x80 | ((cp >> 12) & 0x3F));
+        out += static_cast<char>(0x80 | ((cp >> 6) & 0x3F)); out += static_cast<char>(0x80 | (cp & 0x3F));
+    }
+}
+// A minimal reader for one flat JSON object of strings, booleans, numbers and null.
+struct Value { enum Kind { String, Bool, Other } kind = Other; std::string text; bool flag = false; };
+class Reader {
+public:
+    explicit Reader(const std::string& text) : s_(text) {}
+    bool Object(std::map<std::string, Value>* out, std::string* error) {
+        Skip();
+        if (!Eat('{')) return Fail("esperado '{'", error);
+        Skip();
+        if (Eat('}')) return End(error);
+        while (true) {
+            Skip();
+            std::string key;
+            if (!String(&key)) return Fail("chave invalida", error);
+            Skip();
+            if (!Eat(':')) return Fail("esperado ':'", error);
+            Skip();
+            Value value;
+            if (Peek() == '"') {
+                value.kind = Value::String;
+                if (!String(&value.text)) return Fail("texto invalido", error);
+            } else if (Word("true")) { value.kind = Value::Bool; value.flag = true; }
+            else if (Word("false")) { value.kind = Value::Bool; value.flag = false; }
+            else if (Word("null")) {}
+            else if (!Number()) return Fail("valor invalido", error);
+            (*out)[key] = value;
+            Skip();
+            if (Eat(',')) continue;
+            if (Eat('}')) return End(error);
+            return Fail("esperado ',' ou '}'", error);
+        }
+    }
+private:
+    bool End(std::string* error) { Skip(); return i_ == s_.size() ? true : Fail("texto depois do objeto", error); }
+    bool Fail(const char* what, std::string* error) {
+        if (error) *error = std::string("JSON invalido (") + what + ", posicao " + std::to_string(i_) + ")";
+        return false;
+    }
+    char Peek() const { return i_ < s_.size() ? s_[i_] : '\0'; }
+    bool Eat(char c) { if (Peek() != c) return false; ++i_; return true; }
+    void Skip() { while (i_ < s_.size() && (s_[i_] == ' ' || s_[i_] == '\t' || s_[i_] == '\n' || s_[i_] == '\r')) ++i_; }
+    bool Word(const char* word) {
+        const std::string w(word);
+        if (s_.compare(i_, w.size(), w) != 0) return false;
+        i_ += w.size();
+        return true;
+    }
+    bool Number() {
+        const size_t start = i_;
+        while (i_ < s_.size() && std::string("+-0123456789.eE").find(s_[i_]) != std::string::npos) ++i_;
+        return i_ > start;
+    }
+    bool Hex4(unsigned long* value) {
+        if (i_ + 4 > s_.size()) return false;
+        *value = 0;
+        for (int k = 0; k < 4; ++k) {
+            const char c = s_[i_++];
+            *value <<= 4;
+            if (c >= '0' && c <= '9') *value |= static_cast<unsigned long>(c - '0');
+            else if (c >= 'a' && c <= 'f') *value |= static_cast<unsigned long>(c - 'a' + 10);
+            else if (c >= 'A' && c <= 'F') *value |= static_cast<unsigned long>(c - 'A' + 10);
+            else return false;
+        }
+        return true;
+    }
+    bool String(std::string* out) {
+        if (!Eat('"')) return false;
+        out->clear();
+        while (i_ < s_.size()) {
+            const char c = s_[i_++];
+            if (c == '"') return true;
+            if (static_cast<unsigned char>(c) < 0x20) return false;
+            if (c != '\\') { *out += c; continue; }
+            if (i_ >= s_.size()) return false;
+            const char e = s_[i_++];
+            switch (e) {
+            case '"': *out += '"'; break;
+            case '\\': *out += '\\'; break;
+            case '/': *out += '/'; break;
+            case 'b': *out += '\b'; break;
+            case 'f': *out += '\f'; break;
+            case 'n': *out += '\n'; break;
+            case 'r': *out += '\r'; break;
+            case 't': *out += '\t'; break;
+            case 'u': {
+                unsigned long cp = 0;
+                if (!Hex4(&cp)) return false;
+                if (cp >= 0xD800 && cp <= 0xDBFF) {
+                    unsigned long low = 0;
+                    if (!Eat('\\') || !Eat('u') || !Hex4(&low) || low < 0xDC00 || low > 0xDFFF) return false;
+                    cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);
+                } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
+                    return false;
+                }
+                AppendUtf8(*out, cp);
+                break;
+            }
+            default: return false;
+            }
+        }
+        return false;
+    }
+    const std::string& s_;
+    size_t i_ = 0;
+};
+} // namespace
+
+std::string SerializeMicSettings(const MicSettings& settings) {
+    std::string out = "{\n  \"format\": ";
+    AppendEscaped(out, kMicSettingsFormat);
+    out += ",\n  \"enabled\": ";
+    out += settings.enabled ? "true" : "false";
+    out += ",\n  \"device_id\": ";
+    AppendEscaped(out, settings.deviceId);
+    out += ",\n  \"device_name\": ";
+    AppendEscaped(out, settings.deviceName);
+    out += "\n}\n";
+    return out;
+}
+
+bool ParseMicSettings(const std::string& text, MicSettings* settings, std::string* error) {
+    std::string body = text;
+    if (body.size() >= 3 && static_cast<unsigned char>(body[0]) == 0xEF && static_cast<unsigned char>(body[1]) == 0xBB &&
+        static_cast<unsigned char>(body[2]) == 0xBF) body.erase(0, 3);  // a BOM from Notepad
+    std::map<std::string, Value> values;
+    Reader reader(body);
+    if (!reader.Object(&values, error)) return false;
+    const auto format = values.find("format");
+    if (format != values.end() && (format->second.kind != Value::String || format->second.text != kMicSettingsFormat)) {
+        if (error) *error = "formato desconhecido (esperado " + std::string(kMicSettingsFormat) + ")";
+        return false;
+    }
+    MicSettings result;
+    if (const auto it = values.find("enabled"); it != values.end()) {
+        if (it->second.kind != Value::Bool) { if (error) *error = "\"enabled\" deve ser true ou false"; return false; }
+        result.enabled = it->second.flag;
+    }
+    for (const auto& [key, field] : {std::pair<const char*, std::string*>{"device_id", &result.deviceId},
+                                     std::pair<const char*, std::string*>{"device_name", &result.deviceName}}) {
+        const auto it = values.find(key);
+        if (it == values.end()) continue;
+        if (it->second.kind != Value::String) { if (error) *error = std::string("\"") + key + "\" deve ser texto"; return false; }
+        *field = it->second.text;
+    }
+    *settings = result;
+    return true;
+}
+
+MicFileLoad LoadMicSettingsFile(const std::filesystem::path& path, MicSettings* settings, std::string* error) {
+    std::error_code ec;
+    if (!std::filesystem::exists(path, ec)) return MicFileLoad::Missing;
+    std::ifstream file(path, std::ios::binary);
+    if (!file) { if (error) *error = "nao foi possivel ler " + PathText(path); return MicFileLoad::Invalid; }
+    std::ostringstream text;
+    text << file.rdbuf();
+    if (text.str().size() > 64 * 1024) { if (error) *error = "arquivo grande demais"; return MicFileLoad::Invalid; }
+    return ParseMicSettings(text.str(), settings, error) ? MicFileLoad::Loaded : MicFileLoad::Invalid;
+}
+
+bool SaveMicSettingsFile(const std::filesystem::path& path, const MicSettings& settings, std::string* error) {
+    std::error_code ec;
+    if (path.has_parent_path()) std::filesystem::create_directories(path.parent_path(), ec);
+    auto temporary = path;
+    temporary += ".tmp";
+    {
+        std::ofstream file(temporary, std::ios::binary | std::ios::trunc);
+        if (!file) { if (error) *error = "nao foi possivel criar " + PathText(temporary); return false; }
+        file << SerializeMicSettings(settings);
+        file.flush();
+        if (!file) { if (error) *error = "falha ao escrever " + PathText(temporary); return false; }
+    }
+    std::filesystem::rename(temporary, path, ec);
+    if (ec) {
+        std::filesystem::remove(temporary, ec);
+        if (error) *error = "nao foi possivel substituir " + PathText(path);
+        return false;
+    }
+    return true;
+}
+
+MicDeviceResolution ResolveMicDevice(const std::vector<MicDeviceEntry>& devices, const MicSettings& wanted) {
+    MicDeviceResolution result;
+    result.name = kMicDefaultDeviceLabel;
+    if (wanted.deviceId.empty() && wanted.deviceName.empty()) return result;
+    result.requestedDefault = false;
+    for (const auto& device : devices) {
+        if (!wanted.deviceId.empty() && device.id == wanted.deviceId) {
+            result.id = device.id;
+            result.name = device.name;
+            return result;
+        }
+    }
+    if (!wanted.deviceName.empty()) {
+        for (const auto& device : devices) {
+            if (device.name == wanted.deviceName) {
+                result.id = device.id;
+                result.name = device.name;
+                result.matchedByName = true;
+                return result;
+            }
+        }
+    }
+    result.found = false;
+    return result;
+}
+
+std::optional<std::size_t> ParseMicDeviceIndex(const std::string& text, std::size_t count) {
+    if (text.empty() || text.size() > 6) return std::nullopt;
+    std::size_t value = 0;
+    for (char c : text) {
+        if (c < '0' || c > '9') return std::nullopt;
+        value = value * 10 + static_cast<std::size_t>(c - '0');
+    }
+    if (value >= count) return std::nullopt;
+    return value;
+}
+
+MicStartupPlan PlanMicStartup(const std::string& environmentEnabled, const std::string& environmentDevice,
+                              const std::optional<MicSettings>& saved, const std::vector<MicDeviceEntry>& devices) {
+    MicStartupPlan plan;
+    if (environmentEnabled == "1") plan.enabled = true;
+    else if (environmentEnabled == "0") plan.enabled = false;
+    else plan.enabled = saved.has_value() && saved->enabled;
+    if (!environmentDevice.empty()) {
+        if (const auto index = ParseMicDeviceIndex(environmentDevice, devices.size())) {
+            plan.wanted.deviceId = devices[*index].id;
+            plan.wanted.deviceName = devices[*index].name;
+            plan.source = MicSelectionSource::Environment;
+        } else {
+            plan.notice = "TRIAEVUM_OCARINA_MIC_DEVICE=" + environmentDevice + " n\xC3\xA3o existe na lista; ";
+            plan.notice += saved.has_value() ? "usando a escolha salva" : "usando o padr\xC3\xA3o do Windows";
+        }
+    }
+    if (plan.source != MicSelectionSource::Environment && saved.has_value()) {
+        plan.wanted.deviceId = saved->deviceId;
+        plan.wanted.deviceName = saved->deviceName;
+        plan.source = saved->deviceId.empty() && saved->deviceName.empty() ? MicSelectionSource::Default : MicSelectionSource::Saved;
+    }
+    plan.wanted.enabled = plan.enabled;
+    plan.device = ResolveMicDevice(devices, plan.wanted);
+    if (!plan.device.found) {
+        const std::string name = plan.wanted.deviceName.empty() ? plan.wanted.deviceId : plan.wanted.deviceName;
+        if (!plan.notice.empty()) plan.notice += ". ";
+        plan.notice += "Microfone salvo \"" + name + "\" n\xC3\xA3o encontrado; usando o padr\xC3\xA3o do Windows";
+    }
+    return plan;
+}
+
+std::vector<std::string> MicChoiceLabels(const std::vector<MicDeviceEntry>& devices) {
+    std::vector<std::string> labels{kMicDefaultDeviceLabel};
+    for (std::size_t i = 0; i < devices.size(); ++i) {
+        const auto& name = devices[i].name.empty() ? devices[i].id : devices[i].name;
+        const auto total = std::count_if(devices.begin(), devices.end(), [&](const MicDeviceEntry& d) { return d.name == devices[i].name; });
+        if (total > 1) {
+            const auto ordinal = std::count_if(devices.begin(), devices.begin() + static_cast<std::ptrdiff_t>(i) + 1,
+                                               [&](const MicDeviceEntry& d) { return d.name == devices[i].name; });
+            labels.push_back(name + " (" + std::to_string(ordinal) + ")");
+        } else {
+            labels.push_back(name);
+        }
+    }
+    return labels;
+}
+
+int MicChoiceIndex(const std::vector<MicDeviceEntry>& devices, const std::string& deviceId) {
+    if (deviceId.empty()) return 0;
+    for (std::size_t i = 0; i < devices.size(); ++i)
+        if (devices[i].id == deviceId) return static_cast<int>(i) + 1;
+    return 0;
+}
+
+MicSettings MicSettingsForChoice(const std::vector<MicDeviceEntry>& devices, int choice, bool enabled) {
+    MicSettings settings;
+    settings.enabled = enabled;
+    if (choice >= 1 && static_cast<std::size_t>(choice) <= devices.size()) {
+        settings.deviceId = devices[static_cast<std::size_t>(choice) - 1].id;
+        settings.deviceName = devices[static_cast<std::size_t>(choice) - 1].name;
+    }
+    return settings;
+}
+
+namespace {
+double Decibels(float rms) {
+    if (!std::isfinite(rms) || rms <= 1e-6f) return -120.0;
+    return 20.0 * std::log10(static_cast<double>(rms));
+}
+}
+
+std::string MicLevelBar(float rms, int cells) {
+    cells = std::clamp(cells, 1, 64);
+    const double fraction = std::clamp((Decibels(rms) + 60.0) / 60.0, 0.0, 1.0);
+    const int filled = static_cast<int>(std::lround(fraction * cells));
+    std::string bar;
+    for (int i = 0; i < cells; ++i) bar += i < filled ? "|" : "\xC2\xB7";  // | and middle dot
+    return bar;
+}
+
+std::string MicLevelDecibels(float rms) {
+    const double db = Decibels(rms);
+    if (db <= -90.0) return "sil\xC3\xAAncio";
+    return std::to_string(static_cast<int>(std::lround(db))) + " dB";
+}
+
+std::string MicNoteName(float midiPitch) {
+    if (!std::isfinite(midiPitch) || midiPitch < 0 || midiPitch > 140) return "?";
+    static constexpr const char* names[] = {"D\xC3\xB3", "D\xC3\xB3#", "R\xC3\xA9", "R\xC3\xA9#", "Mi", "F\xC3\xA1",
+                                            "F\xC3\xA1#", "Sol", "Sol#", "L\xC3\xA1", "L\xC3\xA1#", "Si"};
+    const int midi = static_cast<int>(std::lround(midiPitch));
+    return std::string(names[midi % 12]) + std::to_string(midi / 12 - 1);
+}
+
+}
diff --git a/tools/real_instrument/src/note_tracker.cpp b/tools/real_instrument/src/note_tracker.cpp
new file mode 100644
index 00000000..38033e22
--- /dev/null
+++ b/tools/real_instrument/src/note_tracker.cpp
@@ -0,0 +1,65 @@
+#include "real_instrument/note_tracker.h"
+#include <algorithm>
+#include <cmath>
+namespace real_instrument {
+NoteTracker::NoteTracker(float floor) {
+    if(std::isfinite(floor) && floor>=0 && floor<=1)noiseFloor_=floor;
+}
+std::optional<NoteEvent> NoteTracker::Push(PitchFrame f) {
+    if(!std::isfinite(f.timeSeconds)) { Reset(); return {}; }
+    if(lastTime_>=0 && (f.timeSeconds<=lastTime_ || f.timeSeconds-lastTime_>0.25)) Reset();
+    const double elapsed=lastTime_>=0 ? f.timeSeconds-lastTime_ : 0;
+    // Follow the local envelope. A fixed lifetime peak falsely treats natural
+    // decay as a release, then starts another note at the quieter volume.
+    peakRms_*=static_cast<float>(std::exp(-elapsed/0.1));
+    lastTime_=f.timeSeconds;
+    const bool valid=f.voiced && std::isfinite(f.midiPitch) && std::isfinite(f.rms)
+        && std::isfinite(f.confidence) && f.confidence>=0.75f && f.rms>=noiseFloor_
+        && (!active_ || f.rms>=peakRms_*0.25f);
+    if(!valid) {
+        candidate_.reset();
+        // Real low-energy articulation can separate repeated notes faster
+        // than a pitch-confidence dropout. Keep the longer debounce for
+        // vibrato/noisy frames whose signal is still audible.
+        const double releaseSeconds=f.rms<noiseFloor_ ? 0.025 : 0.06;
+        if(active_ && f.timeSeconds-lastVoiced_>=releaseSeconds) {
+            auto done=active_; active_.reset(); peakRms_=0; return done;
+        }
+        return {};
+    }
+    if(active_ && std::abs(f.midiPitch-active_->midiPitch)<=0.75f) {
+        activePitchSum_+=f.midiPitch; ++activeSamples_;
+        active_->midiPitch=static_cast<float>(activePitchSum_/activeSamples_);
+        candidate_.reset(); active_->endedAt=f.timeSeconds; lastVoiced_=f.timeSeconds;
+        peakRms_=std::max(peakRms_,f.rms); return {};
+    }
+    if(!candidate_ || std::abs(f.midiPitch-candidate_->midiPitch)>0.75f) {
+        candidate_=f; sumPitch_=f.midiPitch; sumConfidence_=f.confidence; samples_=1;
+        return {};
+    }
+    sumPitch_+=f.midiPitch; sumConfidence_+=f.confidence; ++samples_;
+    // A nearby pitch during a held note needs more evidence: this keeps a
+    // brief D-D#-D bend/vibrato in one note, without swallowing a stable D#.
+    const bool nearby=active_ && std::max(std::abs(candidate_->midiPitch-active_->midiPitch),
+        std::abs(f.midiPitch-active_->midiPitch))<=1.5f;
+    const double settleSeconds=nearby ? 0.18 : (active_ ? 0.05 : 0.06);
+    if(f.timeSeconds-candidate_->timeSeconds<settleSeconds) return {};
+    // A moving slide has not landed. Restart the candidate around its current
+    // pitch instead of committing staircase notes along the trajectory.
+    if(active_ && std::abs(f.midiPitch-candidate_->midiPitch)>0.25f) {
+        candidate_=f;sumPitch_=f.midiPitch;sumConfidence_=f.confidence;samples_=1;
+        return {};
+    }
+    auto done=active_;
+    active_=NoteEvent{candidate_->timeSeconds,f.timeSeconds,
+        static_cast<float>(sumPitch_/samples_),static_cast<float>(sumConfidence_/samples_)};
+    activePitchSum_=sumPitch_; activeSamples_=samples_;
+    candidate_.reset(); lastVoiced_=f.timeSeconds; peakRms_=f.rms;
+    return done;
+}
+void NoteTracker::Reset() {
+    active_.reset(); candidate_.reset(); lastTime_=-1; lastVoiced_=0;
+    sumPitch_=0; sumConfidence_=0; samples_=0; peakRms_=0;
+    activePitchSum_=0;activeSamples_=0;
+}
+}
diff --git a/tools/real_instrument/src/pitch_detector.cpp b/tools/real_instrument/src/pitch_detector.cpp
new file mode 100644
index 00000000..8a304d0b
--- /dev/null
+++ b/tools/real_instrument/src/pitch_detector.cpp
@@ -0,0 +1,59 @@
+#include "real_instrument/pitch_detector.h"
+#include <algorithm>
+#include <cmath>
+namespace real_instrument {
+PitchDetector::PitchDetector(float floor) : noiseFloor_(floor) {
+    if (!std::isfinite(floor) || floor < 0 || floor > 1) noiseFloor_ = 0.005f;
+}
+PitchFrame PitchDetector::Process(const float* pcm, size_t count, uint32_t rate, double t) {
+    PitchFrame result{t};
+    if (!pcm || count < 512 || count > 32768 || rate < 8000 || rate > 192000 || !std::isfinite(t)) return result;
+    double energy=0, mean=0;
+    for(size_t i=0;i<count;++i) {
+        if (!std::isfinite(pcm[i])) return result;
+        mean += pcm[i];
+    }
+    mean /= static_cast<double>(count);
+    for(size_t i=0;i<count;++i) { double v=pcm[i]-mean; energy+=v*v; }
+    result.rms=static_cast<float>(std::sqrt(energy/static_cast<double>(count)));
+    if(result.rms < noiseFloor_) return result;
+    const size_t minTau=std::max<size_t>(2,rate/4000);
+    const size_t maxTau=std::min<size_t>(rate/60,count/2-1);
+    if (minTau>=maxTau) return result;
+    difference_.assign(maxTau+1,1.0);
+    const size_t window=count-maxTau;
+    double running=0;
+    for(size_t tau=1;tau<=maxTau;++tau) {
+        double difference=0;
+        for(size_t i=0;i<window;++i) { double d=pcm[i]-pcm[i+tau]; difference+=d*d; }
+        running+=difference;
+        difference_[tau]=running>1e-15 ? difference*static_cast<double>(tau)/running : 1.0;
+    }
+    size_t best=0;
+    for(size_t tau=minTau;tau<maxTau;++tau) {
+        if(difference_[tau]<0.25) {
+            // Breathy voice adds small local ripples to the YIN valley. The
+            // first upward sample is not necessarily the period minimum.
+            // Search the rest of this valley, bounded before the next period.
+            best=tau;
+            const size_t end=std::min(maxTau,tau+std::max<size_t>(3,tau/3));
+            for(size_t candidate=tau+1;candidate<end;++candidate){
+                if(difference_[candidate]>0.35)break;
+                if(difference_[candidate]<difference_[best])best=candidate;
+            }
+            break;
+        }
+    }
+    if(!best) return result;
+    double refined=static_cast<double>(best);
+    const double left=difference_[best-1], center=difference_[best], right=difference_[best+1];
+    const double denominator=left-2*center+right;
+    if(std::abs(denominator)>1e-15) refined+=std::clamp(0.5*(left-right)/denominator,-0.5,0.5);
+    double hz=static_cast<double>(rate)/refined;
+    if(hz<60 || hz>4000) return result;
+    result.confidence=static_cast<float>(std::clamp(1-center,0.0,1.0));
+    result.midiPitch=static_cast<float>(69+12*std::log2(hz/440));
+    result.voiced=result.confidence>=0.75f;
+    return result;
+}
+}
diff --git a/tools/real_instrument/src/session.cpp b/tools/real_instrument/src/session.cpp
new file mode 100644
index 00000000..138bf884
--- /dev/null
+++ b/tools/real_instrument/src/session.cpp
@@ -0,0 +1,62 @@
+#include "real_instrument/session.h"
+#include "real_instrument/song_catalog.h"
+#include <algorithm>
+#include <cmath>
+namespace real_instrument {
+RecognitionSession::RecognitionSession(bool assisted,float floor):detector_(floor),tracker_(floor),matcher_(SongCatalog(),assisted) {
+    if(std::isfinite(floor) && floor>=0 && floor<=1)noiseFloor_=floor;
+}
+void RecognitionSession::Start(){running_=true;Reset();}
+void RecognitionSession::Stop(){running_=false;Reset();}
+void RecognitionSession::Reset(){tracker_.Reset();matcher_.Reset();rate_=0;cursor_=filled_=sinceHop_=0;nextTime_=-1;lastNoteEnd_=-1;unvoicedSince_=-1;}
+SessionUpdate RecognitionSession::Process(const float* pcm,size_t frames,uint32_t channels,uint32_t rate,double start) {
+    SessionUpdate out;
+    if(!running_)return out;
+    if(!pcm || !frames || channels<1 || channels>32 || rate<8000 || rate>192000
+        || !std::isfinite(start) || frames>rate/4) {Reset();out.discontinuity=true;return out;}
+    if(rate_ && (rate_!=rate || (nextTime_>=0 && std::abs(start-nextTime_)>0.03))) {
+        Reset();out.discontinuity=true;
+    }
+    if(!rate_) {
+        rate_=rate;
+        const size_t count=std::max<size_t>(512,static_cast<size_t>(2048.0*rate/48000.0));
+        ring_.assign(count,0);window_.resize(count);
+        hop_=std::max<size_t>(1,static_cast<size_t>(512.0*rate/48000.0));
+    }
+    for(size_t i=0;i<frames;++i) {
+        double mono=0;
+        for(uint32_t c=0;c<channels;++c) {
+            float v=pcm[i*channels+c];
+            if(!std::isfinite(v)) {Reset();out={};out.discontinuity=true;return out;}
+            mono+=v;
+        }
+        ring_[cursor_]=static_cast<float>(mono/channels);
+        cursor_=(cursor_+1)%ring_.size(); filled_=std::min(filled_+1,ring_.size());++sinceHop_;
+        if(filled_==ring_.size() && sinceHop_>=hop_) {
+            sinceHop_=0;
+            for(size_t j=0;j<ring_.size();++j) window_[j]=ring_[(cursor_+j)%ring_.size()];
+            auto pitch=detector_.Process(window_.data(),window_.size(),rate,start+static_cast<double>(i)/rate);
+            // The long pitch window contains old sound after release. A short energy
+            // gate timestamps silence promptly rather than sustaining the last note.
+            double recentEnergy=0;
+            for(size_t j=window_.size()-hop_;j<window_.size();++j)recentEnergy+=window_[j]*window_[j];
+            pitch.rms=static_cast<float>(std::sqrt(recentEnergy/static_cast<double>(hop_)));
+            if(pitch.rms<noiseFloor_)pitch.voiced=false;
+            out.pitch=pitch;out.hasPitch=true;
+            if(auto note=tracker_.Push(pitch)) {
+                out.notes.push_back(*note);
+                if(auto song=matcher_.Push(*note))out.song=std::move(song);
+                out.hint=matcher_.Hint();
+                lastNoteEnd_=note->endedAt;
+            }
+            if(pitch.voiced)unvoicedSince_=-1;else if(unvoicedSince_<0)unvoicedSince_=pitch.timeSeconds;
+            if(lastNoteEnd_>=0 && unvoicedSince_>=0 && pitch.timeSeconds-std::max(unvoicedSince_,lastNoteEnd_)>=0.9){
+                lastNoteEnd_=-1;
+                if(auto offer=matcher_.Finish())out.hint=offer;
+            }
+        }
+    }
+    nextTime_=start+static_cast<double>(frames)/rate;
+    return out;
+}
+}
diff --git a/tools/real_instrument/src/song_catalog.cpp b/tools/real_instrument/src/song_catalog.cpp
new file mode 100644
index 00000000..44ce2221
--- /dev/null
+++ b/tools/real_instrument/src/song_catalog.cpp
@@ -0,0 +1,32 @@
+#include "real_instrument/song_catalog.h"
+namespace real_instrument {
+const std::array<NativeSongDefinition,12>& NativeSongCatalog() {
+    // Verified against locally normalized OoT3D tables 0x4D53C8/0x4D541C.
+    static const std::array<NativeSongDefinition,12> songs{{
+        {"Zelda's Lullaby",{3,4,2,3,4,2},6,96},
+        {"Sun's Song",{2,1,4,2,1,4},6,99},
+        {"Minuet of Forest",{0,4,3,2,3,2},6,90},
+        {"Requiem of Spirit",{0,1,0,2,1,0},6,93},
+        {"Epona's Song",{4,3,2,4,3,2},6,97},
+        {"Song of Time",{2,0,1,2,0,1},6,100},
+        {"Bolero of Fire",{1,0,1,0,2,1,2,1},8,91},
+        {"Nocturne of Shadow",{3,2,2,0,3,2,1},7,94},
+        {"Saria's Song",{1,2,3,1,2,3},6,98},
+        {"Song of Storms",{0,1,4,0,1,4},6,101},
+        {"Serenade of Water",{0,1,2,2,3},5,92},
+        {"Prelude of Light",{4,2,4,2,3,4},6,95}
+    }};
+    return songs;
+}
+std::vector<SongDefinition> SongCatalog() {
+    constexpr float pitches[]={62,65,69,71,74};
+    std::vector<SongDefinition> result;
+    for(const auto& native:NativeSongCatalog()) {
+        SongDefinition song{native.id,{}};
+        for(uint32_t i=0;i<native.length;++i)
+            song.semitones.push_back(pitches[native.notes[i]]-pitches[native.notes[0]]);
+        result.push_back(std::move(song));
+    }
+    return result;
+}
+}
diff --git a/tools/real_instrument/src/song_matcher.cpp b/tools/real_instrument/src/song_matcher.cpp
new file mode 100644
index 00000000..69dd5219
--- /dev/null
+++ b/tools/real_instrument/src/song_matcher.cpp
@@ -0,0 +1,194 @@
+#include "real_instrument/song_matcher.h"
+#include <algorithm>
+#include <cmath>
+#include <functional>
+#include <utility>
+namespace real_instrument {
+namespace {
+bool Connected(const std::vector<NoteEvent>& notes,size_t from,size_t to) {
+    for(size_t i=from;i<to;++i)if(notes[i+1].startedAt-notes[i].endedAt>0.03)return false;
+    return true;
+}
+bool Ornament(const std::vector<NoteEvent>& notes,size_t index,size_t before,size_t after) {
+    const auto& n=notes[index];
+    const float low=std::min(notes[before].midiPitch,notes[after].midiPitch);
+    const float high=std::max(notes[before].midiPitch,notes[after].midiPitch);
+    const float distance=std::min(std::abs(n.midiPitch-notes[before].midiPitch),std::abs(n.midiPitch-notes[after].midiPitch));
+    // Brief neighboring pitches and intermediate steps of a slide can be
+    // discarded. Stable unrelated notes may not be deleted to invent a song.
+    if(n.endedAt-n.startedAt<=0.18 && (distance<=1.5f || (n.midiPitch>=low-0.5f && n.midiPitch<=high+0.5f)))return true;
+    // A sustained note can have been split by a short excursion and returned
+    // to its original pitch. Accept duplicate fragments only across continuous
+    // sound, not two deliberately rearticulated notes separated by a pause.
+    for(size_t anchor:{before,after}) {
+        if(std::abs(n.midiPitch-notes[anchor].midiPitch)>0.35f)continue;
+        size_t first=std::min(index,anchor),last=std::max(index,anchor);
+        if(!Connected(notes,first,last))continue;
+        bool adjacent=true;
+        for(size_t i=first+1;i<last;++i) {
+            if(notes[i].endedAt-notes[i].startedAt>0.18
+                || std::abs(notes[i].midiPitch-n.midiPitch)>1.5f)adjacent=false;
+        }
+        if(adjacent)return true;
+    }
+    return false;
+}
+bool DistinctiveRise(const std::vector<NoteEvent>& notes,const SongDefinition& song,
+    size_t begin,const std::vector<size_t>& selected) {
+    const bool saria=song.id=="Saria's Song",storms=song.id=="Song of Storms";
+    if(!saria && !storms)return true;
+    // Absolute tuning remains free. Check the two adjacent rises in EACH
+    // three-note motif, so averaging can't hide contradictory halves.
+    for(size_t motif=0;motif+2<selected.size();motif+=3){
+        float first=notes[begin+selected[motif+1]].midiPitch-notes[begin+selected[motif]].midiPitch;
+        float final=notes[begin+selected[motif+2]].midiPitch-notes[begin+selected[motif+1]].midiPitch;
+        if(saria && !(first>=2.5f && final>=0.5f && final<=3.5f && first-final>=0.5f))return false;
+        if(storms && !(first>=1.f && final>=6.f && final-first>=2.5f))return false;
+    }
+    return true;
+}
+bool RisingMotifs(const std::vector<NoteEvent>& notes){
+    if(notes.size()<6)return false;
+    const size_t begin=notes.size()-6;
+    for(size_t motif:{0U,3U}){
+        float a=notes[begin+motif].midiPitch,b=notes[begin+motif+1].midiPitch,c=notes[begin+motif+2].midiPitch;
+        if(b-a<2.f || b-a>6.5f || c-b<0.5f || c-b>12.f || c-a<4.f || c-a>16.f)return false;
+    }
+    for(size_t i=0;i<3;++i)if(std::abs(notes[begin+i].midiPitch-notes[begin+i+3].midiPitch)>2.f)return false;
+    return true;
+}
+float AlignmentScore(const std::vector<NoteEvent>& notes,const SongDefinition& song,
+    size_t begin,size_t span,const std::vector<size_t>& selected,bool assisted,bool requireSignature) {
+    if(requireSignature && !DistinctiveRise(notes,song,begin,selected))return 0;
+    const size_t length=selected.size();
+    std::vector<float> offsets;offsets.reserve(length);
+    for(size_t i=0;i<length;++i)offsets.push_back(notes[begin+selected[i]].midiPitch-song.semitones[i]);
+    std::sort(offsets.begin(),offsets.end());
+    float offset=offsets[length/2];
+    if(length%2==0)offset=(offset+offsets[length/2-1])*0.5f;
+    const float tolerance=assisted?1.5f:0.35f;
+    double error=0;
+    for(size_t i=0;i<length;++i){
+        float residual=notes[begin+selected[i]].midiPitch-song.semitones[i]-offset;
+        if(!std::isfinite(residual)||std::abs(residual)>tolerance)return 0;
+        error+=residual*residual;
+    }
+    for(size_t i=0;i+1<length;++i){
+        for(size_t skipped=selected[i]+1;skipped<selected[i+1];++skipped)
+            if(!Ornament(notes,begin+skipped,begin+selected[i],begin+selected[i+1]))return 0;
+    }
+    const float rms=static_cast<float>(std::sqrt(error/static_cast<double>(length)));
+    return 1.0f-(assisted?0.2f:0.3f)*rms-0.035f*static_cast<float>(span-length);
+}
+// Assisted fallback: "parecido com o esperado". Each interval must go the same
+// direction as the song's (repeats stay repeats) and may be off by several
+// semitones. Used only to PROPOSE candidates for the player to confirm.
+float LooseScore(const std::vector<NoteEvent>& notes,const SongDefinition& song) {
+    const size_t length=song.semitones.size();
+    if(length<5||length>notes.size())return 0;
+    const size_t begin=notes.size()-length;
+    double total=0;
+    for(size_t i=0;i+1<length;++i){
+        float expected=song.semitones[i+1]-song.semitones[i];
+        float observed=notes[begin+i+1].midiPitch-notes[begin+i].midiPitch;
+        if(std::abs(expected)<0.5f){if(std::abs(observed)>1.6f)return 0;}
+        else if(observed*expected<=0 || std::abs(observed)<1.f)return 0;
+        float diff=std::abs(observed-expected);
+        if(diff>5.f)return 0;
+        total+=diff;
+    }
+    return 1.0f-static_cast<float>(total/static_cast<double>(length-1))/6.0f;
+}
+float BestAlignment(const std::vector<NoteEvent>& notes,const SongDefinition& song,bool assisted,bool requireSignature=true) {
+    const size_t length=song.semitones.size();
+    if(length<3||length>notes.size()||length>32)return 0;
+    float best=0;
+    for(size_t span=length;span<=std::min(notes.size(),length+(assisted?2U:0U));++span){
+        const size_t begin=notes.size()-span;
+        std::vector<size_t> selected;selected.reserve(length);selected.push_back(0);
+        // At most two insertions: bounded combinations, not unconstrained
+        // subsequence search. The first and last observed notes must match.
+        std::function<void(size_t)> visit=[&](size_t next){
+            if(selected.size()==length-1){
+                if(next>span-1)return;
+                selected.push_back(span-1);
+                best=std::max(best,AlignmentScore(notes,song,begin,span,selected,assisted,requireSignature));
+                selected.pop_back();return;
+            }
+            size_t remaining=length-selected.size()-1;
+            for(size_t i=next;i+remaining<span;++i){selected.push_back(i);visit(i+1);selected.pop_back();}
+        };
+        visit(1);
+    }
+    return best;
+}
+}
+SongMatcher::SongMatcher(std::vector<SongDefinition> catalog,bool assisted) : catalog_(std::move(catalog)),assisted_(assisted) {}
+std::optional<SongResult> SongMatcher::Push(NoteEvent n) {
+    if(latched_) return {};
+    if(!std::isfinite(n.midiPitch) || !std::isfinite(n.startedAt) || !std::isfinite(n.endedAt)
+        || !std::isfinite(n.confidence) || n.confidence<0.75f || n.endedAt<n.startedAt) { Reset(); return {}; }
+    if(n.endedAt-n.startedAt<0.06)return {};
+    if(!notes_.empty() && (n.startedAt<notes_.back().endedAt || n.startedAt-notes_.back().endedAt>1.25)) notes_.clear();
+    notes_.push_back(n);
+    while(notes_.size()>32 || (!notes_.empty() && n.endedAt-notes_.front().startedAt>20)) notes_.erase(notes_.begin());
+    float best=0,second=0,hintRank=0,uncertainRise=0; std::string id;hint_.reset();
+    for(const auto& song:catalog_) {
+        for(size_t count=2;count<=std::min(song.semitones.size(),notes_.size());++count){
+            SongDefinition prefix=song;prefix.semitones.resize(count);
+            // Two notes can provide a display hint, never activate a song.
+            float score=0;
+            if(count==2){
+                const auto& a=notes_[notes_.size()-2];const auto& b=notes_.back();
+                float error=std::abs((b.midiPitch-a.midiPitch)-(prefix.semitones[1]-prefix.semitones[0]));
+                if(error<=(assisted_?2.0f:0.7f))score=1.0f-error*0.2f;
+            }else score=BestAlignment(notes_,prefix,assisted_);
+            float rank=score*static_cast<float>(count)/static_cast<float>(song.semitones.size());
+            if(score>=0.8f && rank>hintRank){hintRank=rank;hint_=SongHint{song.id,count,song.semitones.size(),score};}
+        }
+        float score=BestAlignment(notes_,song,assisted_);
+        if(assisted_ && (song.id=="Saria's Song" || song.id=="Song of Storms") && score<0.8f){
+            float withoutSignature=BestAlignment(notes_,song,assisted_,false);
+            if(withoutSignature>=0.8f)uncertainRise=std::max(uncertainRise,withoutSignature);
+        }
+        if(score>best) {second=best;best=score;id=song.id;} else second=std::max(second,score);
+    }
+    const bool risingPair=assisted_ && RisingMotifs(notes_);
+    const bool clearPair=(id=="Saria's Song" || id=="Song of Storms") && best>=0.9f && best-second>=0.1f;
+    if(risingPair && !clearPair){
+        hint_=SongHint{"Saria's Song",6,6,std::max(best,uncertainRise),"Song of Storms",{"Saria's Song","Song of Storms"}};
+        notes_.clear();return {};
+    }
+    if(best>=0.8f && best-second>=0.1f) {latched_=true;return SongResult{id,best};}
+    if(uncertainRise>=0.8f){
+        hint_=SongHint{"Saria's Song",6,6,uncertainRise,"Song of Storms",{"Saria's Song","Song of Storms"}};
+        // A retry starts a new phrase. Otherwise the tail of this rejected
+        // attempt can combine with its beginning and activate another song.
+        notes_.clear();
+    }
+    return {};
+}
+std::optional<SongHint> SongMatcher::Finish() {
+    // Called when the player stopped (pause after the phrase). A full-length
+    // phrase that loosely resembles songs is offered for confirmation.
+    std::optional<SongHint> offer;
+    if(assisted_ && !latched_ && notes_.size()>=5){
+        std::vector<std::pair<float,std::string>> ranked;
+        for(const auto& song:catalog_){
+            if(notes_.size()>song.semitones.size()+1)continue;
+            float score=LooseScore(notes_,song);
+            if(score>=0.45f)ranked.emplace_back(score,song.id);
+        }
+        if(!ranked.empty()){
+            std::sort(ranked.begin(),ranked.end(),[](const auto& a,const auto& b){return a.first>b.first;});
+            SongHint h{ranked[0].second,0,0,ranked[0].first,"",{}};
+            for(size_t i=0;i<ranked.size() && i<3;++i)h.candidates.push_back(ranked[i].second);
+            h.alternative=h.candidates.size()>1?h.candidates[1]:std::string("-");
+            offer=h;
+        }
+    }
+    notes_.clear();
+    return offer;
+}
+void SongMatcher::Reset() { notes_.clear();latched_=false;hint_.reset(); }
+}
diff --git a/tools/real_instrument/src/wasapi_capture.cpp b/tools/real_instrument/src/wasapi_capture.cpp
new file mode 100644
index 00000000..8b0f59b6
--- /dev/null
+++ b/tools/real_instrument/src/wasapi_capture.cpp
@@ -0,0 +1,131 @@
+#include "wasapi_capture.h"
+#include <windows.h>
+#include <mmdeviceapi.h>
+#include <audioclient.h>
+#include <functiondiscoverykeys_devpkey.h>
+#include <ksmedia.h>
+#include <wrl/client.h>
+#include <algorithm>
+#include <cstring>
+#include <future>
+#include <memory>
+#include <sstream>
+#include <stdexcept>
+namespace real_instrument {
+namespace {
+using Microsoft::WRL::ComPtr;
+void check(HRESULT h,const char* operation){
+    if(FAILED(h)){std::ostringstream s;s<<operation<<" (0x"<<std::hex<<static_cast<unsigned long>(h)<<')';throw std::runtime_error(s.str());}
+}
+struct ComScope {
+    // A thread already in another apartment (a UI thread) can still use the
+    // device enumerator; only a scope that initialized COM uninitializes it.
+    ComScope(){
+        const HRESULT h=CoInitializeEx(nullptr,COINIT_MULTITHREADED);
+        if(h==RPC_E_CHANGED_MODE)return;
+        check(h,"Inicializar audio COM");initialized=true;
+    }
+    ~ComScope(){if(initialized)CoUninitialize();}
+    bool initialized=false;
+};
+std::string utf8(const wchar_t* s){
+    if(!s)return {};
+    int n=WideCharToMultiByte(CP_UTF8,0,s,-1,nullptr,0,nullptr,nullptr);
+    if(n<=1)return {};
+    std::string result(static_cast<size_t>(n),'\0');
+    WideCharToMultiByte(CP_UTF8,0,s,-1,result.data(),n,nullptr,nullptr);result.pop_back();return result;
+}
+std::wstring wide(const std::string& s){
+    int n=MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,s.c_str(),-1,nullptr,0);
+    if(n<1)throw std::runtime_error("ID do microfone invalido");
+    std::wstring result(static_cast<size_t>(n),L'\0');
+    MultiByteToWideChar(CP_UTF8,MB_ERR_INVALID_CHARS,s.c_str(),-1,result.data(),n);result.pop_back();return result;
+}
+ComPtr<IMMDeviceEnumerator> enumerator(){
+    ComPtr<IMMDeviceEnumerator> e;
+    check(CoCreateInstance(__uuidof(MMDeviceEnumerator),nullptr,CLSCTX_ALL,IID_PPV_ARGS(&e)),"Enumerar microfones");return e;
+}
+struct FreeFormat {void operator()(WAVEFORMATEX* p)const{CoTaskMemFree(p);}};
+}
+WasapiCapture::~WasapiCapture(){Stop();}
+std::vector<DeviceInfo> WasapiCapture::ListDevices(){
+    ComScope scope;auto e=enumerator();ComPtr<IMMDeviceCollection> devices;
+    check(e->EnumAudioEndpoints(eCapture,DEVICE_STATE_ACTIVE,&devices),"Listar dispositivos");
+    UINT count=0;check(devices->GetCount(&count),"Contar microfones");std::vector<DeviceInfo> result;
+    for(UINT i=0;i<count;++i){
+        ComPtr<IMMDevice> device;check(devices->Item(i,&device),"Ler dispositivo");
+        LPWSTR raw=nullptr;check(device->GetId(&raw),"Ler ID");std::string id=utf8(raw);CoTaskMemFree(raw);
+        ComPtr<IPropertyStore> properties;check(device->OpenPropertyStore(STGM_READ,&properties),"Ler nome");
+        PROPVARIANT v;PropVariantInit(&v);
+        HRESULT h=properties->GetValue(PKEY_Device_FriendlyName,&v);
+        std::string name=SUCCEEDED(h)&&v.vt==VT_LPWSTR?utf8(v.pwszVal):id;PropVariantClear(&v);
+        result.push_back({id,name});
+    }
+    return result;
+}
+void WasapiCapture::Start(const std::string& id,Callback callback){
+    Stop();if(!callback)throw std::runtime_error("Callback de audio ausente");
+    {std::lock_guard<std::mutex> lock(mutex_);error_.clear();}
+    stop_=false;std::promise<void> ready;auto future=ready.get_future();
+    thread_=std::thread([this,id,callback=std::move(callback),ready=std::move(ready)]()mutable{
+        bool announced=false;
+        try{
+            ComScope scope;auto e=enumerator();ComPtr<IMMDevice> device;
+            if(id.empty())check(e->GetDefaultAudioEndpoint(eCapture,eConsole,&device),"Abrir microfone padrao");
+            else {auto w=wide(id);check(e->GetDevice(w.c_str(),&device),"Abrir microfone selecionado");}
+            ComPtr<IAudioClient> client;
+            check(device->Activate(__uuidof(IAudioClient),CLSCTX_ALL,nullptr,reinterpret_cast<void**>(client.GetAddressOf())),"Ativar captura");
+            WAVEFORMATEX* raw=nullptr;check(client->GetMixFormat(&raw),"Ler formato de audio");
+            std::unique_ptr<WAVEFORMATEX,FreeFormat> format(raw);
+            bool floating=raw->wFormatTag==WAVE_FORMAT_IEEE_FLOAT;
+            bool pcm=raw->wFormatTag==WAVE_FORMAT_PCM;
+            if(raw->wFormatTag==WAVE_FORMAT_EXTENSIBLE && raw->cbSize>=22){
+                const auto* ext=reinterpret_cast<const WAVEFORMATEXTENSIBLE*>(raw);
+                floating=IsEqualGUID(ext->SubFormat,KSDATAFORMAT_SUBTYPE_IEEE_FLOAT)!=0;
+                pcm=IsEqualGUID(ext->SubFormat,KSDATAFORMAT_SUBTYPE_PCM)!=0;
+            }
+            const uint32_t channels=raw->nChannels,rate=raw->nSamplesPerSec,bits=raw->wBitsPerSample;
+            const uint32_t bytes=bits/8;
+            if(channels<1 || channels>32 || rate<8000 || rate>192000
+                || (!(floating&&bits==32) && !(pcm&&(bits==16||bits==24||bits==32)))
+                || raw->nBlockAlign!=channels*bytes)throw std::runtime_error("Formato do microfone nao suportado; selecione PCM 16/24/32 bits ou float 32 bits");
+            check(client->Initialize(AUDCLNT_SHAREMODE_SHARED,0,1000000,0,raw,nullptr),"Inicializar captura (confira permissao do microfone no Windows)");
+            ComPtr<IAudioCaptureClient> capture;check(client->GetService(IID_PPV_ARGS(&capture)),"Obter captura");
+            UINT32 capacity=0;check(client->GetBufferSize(&capacity),"Ler buffer");
+            std::vector<float> samples(static_cast<size_t>(capacity)*channels);
+            check(client->Start(),"Iniciar microfone");
+            struct StopClient {IAudioClient* p;~StopClient(){p->Stop();}} stopClient{client.Get()};
+            announced=true;ready.set_value();
+            while(!stop_){
+                UINT32 packet=0;check(capture->GetNextPacketSize(&packet),"Ler pacote");
+                if(!packet){Sleep(5);continue;}
+                while(packet && !stop_){
+                    BYTE* data=nullptr;UINT32 frames=0;DWORD flags=0;UINT64 position=0,qpc=0;
+                    check(capture->GetBuffer(&data,&frames,&flags,&position,&qpc),"Receber audio");
+                    struct Release {IAudioCaptureClient* p;UINT32 n;~Release(){if(p)p->ReleaseBuffer(n);}} release{capture.Get(),frames};
+                    if(frames>capacity)throw std::runtime_error("Pacote maior que buffer de captura");
+                    const size_t count=static_cast<size_t>(frames)*channels;
+                    if(flags&AUDCLNT_BUFFERFLAGS_SILENT)std::fill_n(samples.data(),count,0.f);
+                    else for(size_t i=0;i<count;++i){
+                        const BYTE* p=data+i*bytes;
+                        if(floating){float v;std::memcpy(&v,p,4);samples[i]=v;}
+                        else if(bits==16){int16_t v;std::memcpy(&v,p,2);samples[i]=static_cast<float>(v)/32768.f;}
+                        else if(bits==32){int32_t v;std::memcpy(&v,p,4);samples[i]=static_cast<float>(v)/2147483648.f;}
+                        else {int32_t v=p[0]|(p[1]<<8)|(p[2]<<16);if(v&0x800000)v-=0x1000000;samples[i]=static_cast<float>(v)/8388608.f;}
+                    }
+                    callback(samples.data(),frames,channels,rate,static_cast<double>(position)/rate,(flags&AUDCLNT_BUFFERFLAGS_DATA_DISCONTINUITY)!=0);
+                    // ReleaseBuffer must run before asking for the next packet.
+                    release.p->ReleaseBuffer(release.n);release.n=0;release.p=nullptr;
+                    check(capture->GetNextPacketSize(&packet),"Proximo pacote");
+                }
+            }
+        }catch(const std::exception& ex){
+            {std::lock_guard<std::mutex> lock(mutex_);error_=ex.what();}
+            if(!announced)ready.set_exception(std::current_exception());
+        }
+    });
+    try{future.get();}catch(...){Stop();throw;}
+}
+void WasapiCapture::Stop(){stop_=true;if(thread_.joinable())thread_.join();}
+std::string WasapiCapture::Error()const{std::lock_guard<std::mutex> lock(mutex_);return error_;}
+}
