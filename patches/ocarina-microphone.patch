@@ -0,0 +1,51 @@
+#pragma once
+#include "types.h"
+#include <array>
+#include <vector>
+#include <cstdint>
+#include <optional>
+#include <string>
+namespace real_instrument {
+struct NativeSongInput {bool learned=false;std::vector<uint32_t> buttons{};};
+struct OcarinaGameState {
+    bool canPlay=false;
+    uint64_t context=0;
+    std::array<NativeSongInput,12> songs;
+};
+struct SongChoice {std::string id;bool learned=false;};
+struct SongConfirmation {
+    uint64_t token=0;
+    bool sariaLearned=false,stormsLearned=false;
+    std::vector<SongChoice> choices; // the "try again" option is index choices.size()
+};
+struct OcarinaInputUpdate {
+    uint32_t buttons=0;
+    bool listen=false;
+    float audioGain=1;
+    uint64_t generation=0;
+};
+// No guest-memory writes: recognized phrases are replayed as ordinary native
+// controller notes, leaving event selection to the game.
+class OcarinaGameInput {
+public:
+    OcarinaInputUpdate Update(const OcarinaGameState& state,bool manualInput,double seconds);
+    void Recognized(SongResult result);
+    void OfferConfirmation();
+    // Offers the given candidates (learned ones only); false if none can be played.
+    bool OfferConfirmation(const std::vector<std::string>& ids);
+    std::optional<SongConfirmation> Confirmation()const;
+    bool ResolveConfirmation(uint64_t token,int choice,double replayDelaySeconds=0); // index into choices, or choices.size()=retry
+    void Reset();
+private:
+    enum class Phase {Idle,Listening,Confirm,Replay,AwaitClose,Manual};
+    Phase phase_=Phase::Idle;
+    uint64_t context_=0,generation_=0;
+    double replayStart_=0,lastTime_=-1,replayDelay_=0;
+    std::optional<SongResult> pending_;
+    std::vector<uint32_t> replay_;
+    bool sariaLearned_=false,stormsLearned_=false;
+    std::array<bool,12> learned_{};
+    std::vector<std::string> offered_;
+};
+}
+
diff --git a/tools/real_instrument/include/real_instrument/game_microphone.h b/tools/real_instrument/include/real_instrument/game_microphone.h
new file mode 100644
index 00000000..b75e1c24
--- /dev/null
+++ b/tools/real_instrument/include/real_instrument/game_microphone.h
@@ -0,0 +1,46 @@
+#pragma once
+#include "game_input.h"
+#include <memory>
+#include <optional>
+#include <string>
+namespace real_instrument {
+// What the in-game menu shows about the microphone (v0.6.0).
+struct MicrophoneStatus {
+    bool open = false;          // the capture is running
+    bool listening = false;     // the ocarina is waiting for a phrase
+    bool monitoring = false;    // the menu keeps the capture open for the meter
+    bool fellBack = false;      // the chosen device failed: the Windows default is in use
+    std::string requestedDeviceId; // empty: the Windows default
+    std::string activeDeviceId;    // the device opened (empty: the Windows default)
+    float level = 0;            // recent RMS level, 0..1
+    std::string lastNote;       // the last voiced pitch ("Sol4"), empty if none yet
+    double lastNoteAgeSeconds = -1;
+    std::string error;          // the last open/capture problem, empty if none
+};
+class GameMicrophone {
+public:
+    static bool EnabledFromEnvironment();
+    GameMicrophone();
+    ~GameMicrophone();
+    GameMicrophone(const GameMicrophone&)=delete;
+    GameMicrophone& operator=(const GameMicrophone&)=delete;
+    OcarinaInputUpdate Tick(const OcarinaGameState& state,bool manualInput,double seconds);
+    std::optional<SongConfirmation> Confirmation() const;
+    bool Resolve(uint64_t token,int choice); // 0=Saria,1=Storms,2=retry
+    void Reset();
+    // v0.6.0, callable from any thread. Selects the device by endpoint ID
+    // (empty: the Windows default) and applies it at once: an open capture is
+    // stopped and reopened on the capture worker. If the device cannot be
+    // opened, or disappears later, the Windows default is used and Status()
+    // reports the error. Until it is called the device comes from
+    // TRIAEVUM_OCARINA_MIC_DEVICE as before.
+    void SetDevice(const std::string& deviceId);
+    // Keeps the capture open while the ocarina is not listening, so the menu
+    // can show the input level and the last note. Samples are not recognized.
+    void SetMonitoring(bool monitoring);
+    MicrophoneStatus Status() const;
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+}
diff --git a/tools/real_instrument/include/real_instrument/mic_controller.h b/tools/real_instrument/include/real_instrument/mic_controller.h
new file mode 100644
index 00000000..1f725efe
--- /dev/null
+++ b/tools/real_instrument/include/real_instrument/mic_controller.h
@@ -0,0 +1,70 @@
+#pragma once
+// The PC microphone owner of the host (v0.6.0): the on/off switch, the device
+// list, the saved choice (<config>/ocarina_microfone.json) and the
+// GameMicrophone the game frame ticks. The in-game menu (Esc > Microfone da
+// Ocarina) drives it. Not thread-safe: call it from the game frame thread;
+// GameMicrophone does its own locking against the capture threads.
+#include "game_microphone.h"
+#include "mic_settings.h"
+#include <cstdint>
+#include <filesystem>
+#include <memory>
+#include <string>
+#include <vector>
+namespace real_instrument {
+class MicController {
+public:
+    struct Options {
+        std::filesystem::path configPath;     // the saved choice
+        std::string environmentEnabled;       // TRIAEVUM_OCARINA_MIC
+        std::string environmentDevice;        // TRIAEVUM_OCARINA_MIC_DEVICE
+    };
+    struct Result {std::string message; bool error=false;};
+    // Options with the two environment variables read.
+    static Options FromEnvironment(std::filesystem::path configPath);
